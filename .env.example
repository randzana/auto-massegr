# Copy this file to .env and fill in the values for the provider you use.
# (.env is ignored by git — never commit your tokens.)

# dry-run | twilio-sms | twilio-whatsapp | whatsapp-cloud
PROVIDER=dry-run

# Added to local numbers that start with 0 (964 = Iraq / Kurdistan)
DEFAULT_COUNTRY_CODE=964

# Seconds between messages
SEND_DELAY=1

# --- Twilio (SMS and WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio SMS number, e.g. +15551234567
TWILIO_FROM=
# Your Twilio WhatsApp sender, e.g. +14155238886
TWILIO_WHATSAPP_FROM=

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Name of an approved message template (needed to message people who
# haven't written to you in the last 24 hours)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US
